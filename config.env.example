# Bar screen dashboard settings. Copied to ~/.config/bar-screen-dashboard/config.env by
# install.sh; edit there, then: systemctl --user restart bar-screen-dashboard

# Which screen to use:
#   auto       - the first connected screen at least BAR_MIN_RATIO times wider than tall
#   HDMI-1     - an output name, as shown by `xrandr`
#   ZeroMOD    - the monitor's own name (from its EDID; see `xrandr --props`)
BAR_SCREEN=auto
BAR_MIN_RATIO=3

# Browser (Chrome or Chromium family). Empty = first of google-chrome, chromium, brave.
BAR_BROWSER=

# Outside temperature. Leave empty to reuse the location of the Weather Glance panel
# widget if you have it; set both to a fixed place otherwise; no location = no temperature.
BAR_LAT=
BAR_LON=
# auto (Weather Glance's setting, else your locale) | celsius | fahrenheit
BAR_UNITS=auto

# Local port for the page (only listens on 127.0.0.1).
BAR_PORT=8765

# Extra page options, '&'-separated:
#   bars=0         no spectrum bars
#   debug          show the preset name, audio level and brightness in a corner
#   force=playing  treat a paused track as playing (to preview the visualizer)
#   cycle=12       switch presets every 12 s (to preview presets)
BAR_QUERY=
